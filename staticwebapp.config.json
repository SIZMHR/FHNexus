{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/auth-popup.html", "/msal-browser.min.js"]
  },
  "routes": [
    {
      "route": "/auth-popup.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/msal-browser.min.js",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-store",
    "Cross-Origin-Opener-Policy": "unsafe-none"
  }
}
